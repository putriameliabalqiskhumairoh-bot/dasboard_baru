<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AIIRRR - Monitoring Ikan Koi</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap');

/* =================================
   ROOT / VARIABEL WARNA
================================= */

     /* =================================
   ROOT / VARIABEL WARNA
================================= */

        :root {
            --bg-body: #eef7fb;
            --sidebar-bg: #16697a;
            --header-bg: #489fb5;

            /* WARNA CARD - UBAH DI SINI */
            --card-bg: #092B57;      /* card kolam, card pH, kartu mini stok */
            --card-bg2: #489fb5;     /* card sensor, stok, jadwal */
            --card-inner: #15355A;   /* kotak di dalam card */
            --card-acidity: #092B57;

            --accent-cyan: #00e5ff;
            --accent-green: #00ffa3;
            --accent-red: #ff4d4d;

            --text-white: #ffffff;
            --text-color: #ffffff;
            --text-muted: #94a3b8;

            --shadow: 0 10px 30px rgba(0,0,0,0.15);
        }

        /* =================================
        RESET
        ================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--bg-body);
            display: flex;
            height: 100vh;
            overflow: hidden;
            color: var(--text-white);
            font-family: 'Space Grotesk', sans-serif;
        }

        /* =================================
        SIDEBAR
        ================================= */

        aside {
            width: 220px;
            min-width: 220px;
            flex: 0 0 220px;
            background-color: var(--sidebar-bg);
            display: flex;
            flex-direction: column;
            padding: 25px 0;
            z-index: 100;
        }

        .brand-header {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .logo {
            padding: 0 30px;
            margin-bottom: 60px;
        }

        .logo h1 {
            color: var(--accent-cyan);
            font-size: 36px;
            font-weight: 800;
            letter-spacing: 2px;
            line-height: 1;
        }

        .logo span {
            font-size: 10px;
            color: var(--text-muted);
            letter-spacing: 1px;
            display: block;
            margin-top: 5px;
        }

        nav ul {
            list-style: none;
        }

        .nav-item {
            padding: 5px 20px;
            margin-bottom: 10px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            padding: 12px 15px;
            color: var(--text-muted);
            text-decoration: none;
            border-radius: 12px;
            transition: all 0.3s ease;
            cursor: pointer;
            font-weight: 500;
            font-size: 14px;
            gap: 10px;
        }

        .nav-link i {
            margin-right: 15px;
            width: 20px;
        }

        .nav-link:hover,
        .nav-link.active {
            background: rgba(0, 229, 255, 0.15);
            color: var(--accent-cyan);
        }

        /* =================================
        MAIN CONTENT
        ================================= */

        main {
            flex: 1;
            min-width: 0;
            position: relative;
            overflow-y: auto;
            padding-bottom: 50px;
        }

        /* =================================
        HEADER GLASSY
        ================================= */

        header {
            width: 100%;
            height: 45px;
            padding: 0 20px;

            display: flex;
            justify-content: flex-end;
            align-items: center;

            background: rgba(72, 159, 181, 0.15);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);

            border-bottom: 1px solid rgba(255,255,255,0.15);
            box-shadow: 0 3px 15px rgba(0,0,0,0.12);

            position: sticky;
            top: 0;
            z-index: 90;

            transition: background 0.3s ease,
                        box-shadow 0.3s ease;
        }

        header.scrolled {
            background: rgba(15, 35, 75, 0.45);
            box-shadow: 0 5px 20px rgba(0,0,0,0.2);
            border-bottom: 1px solid rgba(255,255,255,0.2);
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 15px;
            position: relative;
        }

        .icon-btn {
            background: none;
            border: none;
            color: #4f5b6c;
            cursor: pointer;
            position: relative;
            transition: 0.3s;
        }

        .icon-btn:hover {
            color: var(--accent-cyan);
        }

        .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            cursor: pointer;
            border: 2px solid var(--accent-cyan);
            box-shadow: var(--shadow);
            object-fit: cover;
        }

        /* =================================
        PAGES
        ================================= */

        .page {
            display: none;
            padding: 0 30px;
            animation: fadeIn 0.4s ease-out;
        }

        .page.active {
            display: block;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* =================================
        DASHBOARD BERANDA
        ================================= */

        #beranda {
            display: flex;
            flex-direction: column;
            gap: 32px;
            padding: 25px;
            width: 100%;
            color: var(--text-color);
        }

        #beranda * {
            box-sizing: border-box;
        }

        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 18px;
        }

        .section-heading h2 {
            margin: 0 0 6px;
            font-size: 21px;
            font-weight: 700;
            color:#15355A;
        }

        .section-heading p {
            margin: 0;
            font-size: 13px;
            color: #15355A;
        }

        .section-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 20px;
            font-size: 11px;
            color: var(--text-muted);
        }

        .status-dot {
            width: 7px;
            height: 7px;
            background: #36d399;
            border-radius: 50%;
            box-shadow: 0 0 8px rgba(54,211,153,0.5);
        }

        /* =================================
        GRID KOLAM DAN SENSOR
        ================================= */

        .kolam-grid,
        .sensor-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 22px;
            align-items: stretch;
        }

        /* =================================
        CARD UTAMA
        ================================= */

        .card {
            background-color: var(--card-bg);
            border-radius: 14px;
            padding: 20px;
            box-shadow: var(--shadow);
            position: relative;
            overflow: hidden;
        }

        /* Style bersama (TANPA warna background) */
        .kolam-grid .card,
        .sensor-grid .card {
            min-width: 0;
            width: 100%;
            padding: 14px;
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 18px;

            transition: transform 0.25s ease,
                        box-shadow 0.25s ease,
                        border-color 0.25s ease;
        }

        /* WARNA DIPISAH PER GRID */
        .kolam-grid .card  { background-color: var(--card-bg); }
        .sensor-grid .card { background-color: var(--card-bg2); }
        .sensor-grid .card.acidity-card { background-color: var(--card-acidity); }

        .kolam-grid .card:hover,
        .sensor-grid .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 30px rgba(0,0,0,0.2);
            border-color: rgba(89,190,255,0.3);
        }

        /* =================================
        GAMBAR KOLAM
        ================================= */

        .kolam-img {
            height: 130px;
            position: relative;
            overflow: hidden;
            border-radius: 12px;
            background: var(--header-bg);
            margin-bottom: 18px;
        }

        .kolam-img img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .kolam-card:hover .kolam-img img {
            transform: scale(1.04);
        }

        .tag-kolam {
            position: absolute;
            top: 12px;
            left: 12px;
            z-index: 2;
            padding: 7px 11px;
            background: rgba(5,28,56,0.78);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.18);
            border-radius: 8px;
            color: #ffffff;
            font-size: 11px;
            font-weight: 600;
        }

        /* =================================
        HEADER CARD
        ================================= */

        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin: 18px 0;
        }

        .card-header h3 {
            margin: 0;
            font-size: 17px;
            font-weight: 700;
            color: #ffffff;
        }

        .card-header > i,
        .card-header > svg {
            width: 21px;
            height: 21px;
            color: #ffffff;   /* sebelumnya #092B57 */
        }

        .card-title-sm {
            font-size: 15px;
            font-weight: 700;
            color: #ffffff;
        }

        .card-subtitle {
            margin-top: 5px;
            font-size: 11px;
            color: #ffffff;
        }

        /* =================================
        STATISTIK KOLAM
        ================================= */

        .stat-row {
            display: grid;
            grid-template-columns: repeat(2, minmax(0,1fr));
            gap: 12px;
        }

        .stat-box {
            display: flex;
            flex-direction: column;
            gap: 8px;
            padding: 13px;
            background: var(--card-inner);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 10px;
        }

        .stat-label {
            font-size: 10px;
            letter-spacing: 0.5px;
            color: #9fb5d0;
        }

        .stat-val {
            font-size: 23px;
            font-weight: 700;
            color: #ffffff;
        }

        .green {
            color: #45dfa8;
        }

        .red {
            color: #ff727d;
        }

        /* =================================
        FOOTER CARD
        ================================= */

        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 18px;
            padding-top: 14px;
            border-top: 1px solid rgba(255,255,255,0.09);
        }

        .live-status {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 11px;
            color: #b7c9de;
        }

        .live-status .dot {
            width: 7px;
            height: 7px;
            background: #39d99b;
            border-radius: 50%;
            box-shadow: 0 0 8px rgba(57,217,155,0.5);
        }

        /* =================================
        CARD PERINGATAN
        ================================= */

        .warning-content {
            display: flex;
            align-items: center;
            gap: 18px;
            min-height: 80px;
        }

        .warning-num {
            font-size: 54px;
            line-height: 1;
            font-weight: 800;
            color: #ffbd59;
        }

        .warning-content h3 {
            margin: 0 0 7px;
            font-size: 14px;
            color: #ffffff;
        }

        .warning-content p {
            margin: 0;
            font-size: 11px;
            line-height: 1.5;
            color: #9fb5d0;
        }

        .icon-box {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            border-radius: 12px;
            background: rgba(255,255,255,0.07);
            color: #5fd7ff;
        }

        .icon-box svg {
            width: 21px;
            height: 21px;
        }

        .warning-icon {
            color: #ffbd59;
            background: rgba(255,189,89,0.1);
        }

        .warning-status {
            font-size: 10px;
            font-weight: 600;
            color: #ffbd59;
        }

        /* =================================
        GAUGE PH
        ================================= */

        .acidity-card .card-header {
            margin-bottom: 0;
        }

        .gauge-container {
            position: relative;
            width: 120px;
            max-width: 100%;
            aspect-ratio: 1;
            margin: 12px auto;
        }

        .gauge-svg {
            width: 100%;
            height: 100%;
            display: block;
            transform: rotate(-90deg);
            overflow: visible;
        }

        .gauge-bg,
        .gauge-progress {
            fill: none;
            stroke-width: 10;
        }

        .gauge-bg {
            stroke: rgba(255,255,255,0.09);
        }

        .gauge-progress {
            stroke: #43dda5;
            stroke-linecap: round;
            stroke-dasharray: 408.4;
            stroke-dashoffset: 75;
            filter: drop-shadow(0 0 5px rgba(67,221,165,0.2));
        }

        .gauge-text {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .gauge-val {
            font-size: 32px;
            font-weight: 800;
            color: #ffffff;
        }

        .gauge-label {
            margin-top: 4px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
            color: #43dda5;
        }

        .stability-value {
            font-size: 12px;
            font-weight: 700;
            color: #43dda5;
        }

        /* =================================
        JADWAL PAKAN
        ================================= */

        .feeder-icon {
            color: #66d9ff;
        }

        .automation-item {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 14px 0;
            padding: 15px 12px;
            border-radius: 12px;
            background: var(--card-inner);
            border: 1px solid rgba(255,255,255,0.06);
        }

        .container-icon {
            color: #66d9ff;
            background: rgba(102,217,255,0.1);
        }

        .feeder-info {
            flex: 1;
            min-width: 0;
        }

        .feeder-title {
            font-size: 12px;
            font-weight: 700;
            color: #ffffff;
        }

        .feeder-desc {
            margin-top: 5px;
            font-size: 10px;
            color: #9fb5d0;
            line-height: 1.4;
        }

        .feeder-status {
            font-size: 11px;
            font-weight: 700;
            color: #43dda5;
        }

        .feeder-off {
            color: #ff727d;
        }

        /* =================================
        TOGGLE SWITCH
        ================================= */

        .switch {
            position: relative;
            display: inline-block;
            flex-shrink: 0;
            width: 42px;
            height: 23px;
        }

        .switch input {
            width: 0;
            height: 0;
            opacity: 0;
        }

        .slider {
            position: absolute;
            inset: 0;
            cursor: pointer;
            border-radius: 30px;
            background: #52657c;
            transition: 0.3s;
        }

        .slider::before {
            content: "";
            position: absolute;
            width: 17px;
            height: 17px;
            left: 3px;
            top: 3px;
            border-radius: 50%;
            background: #ffffff;
            transition: 0.3s;
        }

        .switch input:checked + .slider {
            background: #26bf8a;
        }

        .switch input:checked + .slider::before {
            transform: translateX(19px);
        }

        .switch input:focus-visible + .slider {
            outline: 2px solid #66d9ff;
            outline-offset: 3px;
        }

        /* =================================
        POPUP / NOTIFIKASI
        ================================= */

        .popup,
        .notif-popup {
            position: absolute;
            top: 80px;
            right: 30px;
            background: white;
            width: 300px;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            color: #1e293b;
            padding: 20px;
            display: none;
            z-index: 200;
            animation: slideIn 0.3s ease-out;
        }

        @keyframes slideIn {
            from {
                transform: translateY(-10px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .popup-header,
        .notif-header {
            border-bottom: 1px solid #f1f5f9;
            padding-bottom: 10px;
            margin-bottom: 15px;
            font-weight: 700;
            color: var(--sidebar-bg);
        }

        .notif-item {
            display: flex;
            gap: 12px;
            margin-bottom: 12px;
            font-size: 12px;
            color: #475569;
        }

        .notif-dot {
            width: 8px;
            height: 8px;
            flex-shrink: 0;
            background: var(--accent-red);
            border-radius: 50%;
            margin-top: 4px;
        }

        /* =================================
        PROFILE PAGE
        ================================= */

        .profile-card {
            background: white;
            border-radius: 30px;
            padding: 40px;
            display: flex;
            gap: 40px;
            box-shadow: var(--shadow);
            max-width: 1000px;
            margin: 24px auto 0;
        }

        .profile-left {
            text-align: center;
        }

        .profile-img-lg {
            width: 180px;
            height: 180px;
            border-radius: 40px;
            object-fit: cover;
            margin-bottom: 20px;
            border: 5px solid #f1f5f9;
        }

        .profile-right {
            flex: 1;
        }

        .profile-right h2 {
            font-size: 32px;
            color: var(--sidebar-bg);
            margin-bottom: 5px;
        }

        .profile-right p {
            color: #64748b;
            margin-bottom: 30px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .info-item label {
            font-size: 12px;
            color: #94a3b8;
            display: block;
            margin-bottom: 5px;
        }

        .info-item span {
            font-weight: 700;
            color: var(--sidebar-bg);
            font-size: 16px;
        }

        .profile-actions {
            display: flex;
            gap: 15px;
        }

        .btn {
            padding: 14px 28px;
            border-radius: 14px;
            font-weight: 700;
            cursor: pointer;
            border: none;
            transition: 0.3s;
        }

        .btn-edit {
            background: var(--sidebar-bg);
            color: white;
        }

        .btn-logout {
            background: #fee2e2;
            color: #ef4444;
            border: 1px solid #fecaca;
        }

        .btn-logout:hover {
            background: #ef4444;
            color: white;
        }

        /* =================================
        MONITORING PH
        ================================= */

        .ph-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
            margin-top: 20px;
        }

        .ph-card {
            background-color: var(--card-bg);
            border-radius: 20px;
            padding: 25px;
            color: white;
            position: relative;
            box-shadow: var(--shadow);
        }

        .ph-card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 25px;
        }

        .ph-card-header h3 {
            font-size: 22px;
            margin-bottom: 5px;
        }

        .ph-card-header p {
            font-size: 12px;
            color: var(--text-muted);
        }

        .ph-card-header .wave-icon {
            color: var(--accent-green);
            opacity: 0.8;
        }

        .ph-content-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 25px;
        }

        .ph-gauge-wrapper {
            position: relative;
            width: 110px;
            height: 110px;
        }

        .ph-circle {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            border: 8px solid rgba(255,255,255,0.05);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: 800;
        }

        .ph-circle.normal {
            border-top-color: var(--accent-green);
            border-right-color: var(--accent-green);
        }

        .ph-circle.danger {
            border-top-color: var(--accent-red);
            border-right-color: var(--accent-red);
        }

        .ph-stats-side {
            text-align: right;
        }

        .ph-stats-side .label-small {
            font-size: 9px;
            color: var(--text-muted);
            text-transform: uppercase;
            display: block;
            margin-top: 10px;
        }

        .ph-stats-side .val-small {
            font-size: 11px;
            font-weight: 700;
            display: block;
        }

        .ph-stats-side .condition {
            font-size: 12px;
            color: white;
            font-weight: 600;
            margin-top: 4px;
        }

        .btn-instant-feed {
            width: 100%;
            background-color: var(--accent-cyan);
            color: var(--sidebar-bg);
            border: none;
            padding: 12px;
            border-radius: 10px;
            font-weight: 800;
            font-size: 13px;
            cursor: pointer;
            transition: 0.3s;
        }

        .btn-instant-feed:hover {
            filter: brightness(1.1);
            transform: translateY(-2px);
        }

        /* =================================
        STOK DAN RIWAYAT
        ================================= */

        .stok-layout {
            display: flex;
            gap: 25px;
            margin-bottom: 25px;
        }

        .stok-status-card {
            flex: 1;
            background-color: var(--card-bg2);
            border-radius: 24px;
            padding: 30px;
            color: white;
        }

        .stok-item {
            margin-bottom: 25px;
        }

        .stok-info-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 8px;
        }

        .stok-info-top span:first-child {
            font-size: 12px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .stok-info-top .percent {
            font-size: 22px;
            font-weight: 800;
            color: var(--accent-green);
        }

        .progress-track {
            height: 10px;
            background: rgba(255,255,255,0.05);
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 6px;
        }

        .progress-fill {
            height: 100%;
            border-radius: 10px;
            transition: width 1s ease-in-out;
        }

        .stok-info-bottom {
            text-align: right;
            font-size: 10px;
            font-weight: 600;
        }

        .riwayat-tabel-card {
            flex: 1.5;
            background-color: var(--card-bg2);
